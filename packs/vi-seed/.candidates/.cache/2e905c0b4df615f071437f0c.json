irius_A_and_B_artwork.jpg/500px-Sirius_A_and_B_artwork.jpg?utm_source=vi.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","scale":"1x"},{"src":"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Sirius_A_and_B_artwork.jpg/1280px-Sirius_A_and_B_artwork.jpg?utm_source=vi.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","scale":"2x"}]},{"title":"Tập_tin:A_Swarm_of_Ancient_Stars_-_GPN-2000-000930.jpg","leadImage":false,"section_id":14,"type":"image","caption":{"html":"Cụm sao cầu <a rel=\"mw:WikiLink\" href=\"./Messier_80\" title=\"Messier 80\" id=\"mwAw0\">M 80</a>. Các ngôi sao già, nghèo kim loại chiếm đa số trong cụm sao này.","text":"Cụm sao cầu M 80. Các ngôi sao già, nghèo kim loại chiếm đa số trong cụm sao này."},"showInGallery":true,"srcset":[{"src":"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/A_Swarm_of_Ancient_Stars_-_GPN-2000-000930.jpg/500px-A_Swarm_of_Ancient_Stars_-_GPN-2000-000930.jpg?utm_source=vi.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","scale":"1x"},{"src":"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/A_Swarm_of_Ancient_Stars_-_GPN-2000-000930.jpg/1280px-A_Swarm_of_Ancient_Stars_-_GPN-2000-000930.jpg?utm_source=vi.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","scale":"2x"}]},{"title":"Tập_tin:Comparison_of_planets_and_stars_(sheet_by_sheet)_(Apr_2015_update).png","leadImage":false,"section_id":17,"type":"image","caption":{"html":"Sao có nhiều đường kính khác nhau. Ở mỗi hình trong dãy những vật thể ở bên phải là lớn nhất và đứng ngoài cùng bên trái ở bên cạnh hình tiếp theo. <a rel=\"mw:WikiLink\" href=\"./Trái_Đất\" title=\"Trái Đất\" id=\"mwA0Y\">Trái Đất</a> ở ngoài cùng bên phải ở hình thứ 1 và <a rel=\"mw:WikiLink\" href=\"./Mặt_Trời\" title=\"Mặt Trời\" id=\"mwA0c\">Mặt Trời</a> xếp thứ hai từ phải trong hình thứ 3. Ngôi sao ngoài cùng bên phải trong hình 6 là <a rel=\"mw:WikiLink\" href=\"./UY_Scuti\" title=\"UY Scuti\" id=\"mwA0g\">UY Scuti</a>, <a rel=\"mw:WikiLink\" href=\"./Danh_sách_sao_lớn_nhất\" title=\"Danh sách sao lớn nhất\" id=\"mwA0k\">sao lớn thứ hai được biết từ trước tới nay</a>.","text":"Sao có nhiều đường kính khác nhau. Ở mỗi hình trong dãy những vật thể ở bên phải là lớn nhất và đứng ngoài cùng bên trái ở bên cạnh hình tiếp theo. Trái Đất ở ngoài cùng bên phải ở hình thứ 1 và Mặt Trời xếp thứ hai từ phải trong hình thứ 3. Ngôi sao ngoài cùng bên phải trong hình 6 là UY Scuti, sao lớn thứ hai được biết từ trước tới nay."},"showInGallery":true,"srcset":[{"src":"//thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Comparison_of_planets_and_stars_%28sheet_by_sheet%29_%28Apr_2015_update%29.png/500px-Comparison_of_planets_and_stars_%28sheet_by_sheet%29_%28Apr_2015_update%29.png?utm_source=vi.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","scale":"1x"},{"src":"//thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Comparison_of_planets_and_stars_%28sheet_by_sheet%29_%28Apr_2015_update%29.png/1280px-Comparison_of_planets_and_stars_%28sheet_by_sheet%29_%28Apr_2015_update%29.png?utm_source=vi.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","scale":"2x"}]},{"title":"Tập_tin:Pleiades_large.jpg","leadImage":false,"section_id":18,"type":"image","caption":{"html":"<a rel=\"mw:WikiLink\" href=\"./Tua_Rua\" title=\"Tua Rua\" id=\"mwA2I\">Tua Rua</a>, một <a rel=\"mw:WikiLink\" href=\"./Quần_tinh_mở?action=edit&amp;redlink=1\" title=\"Quần tinh mở\" class=\"new\" typeof=\"mw:LocalizedAttrs\" id=\"mwA2M\" data-mw-i18n=\"{&quot;title&quot;:{&quot;lang&quot;:&quot;x-page&quot;,&quot;key&quot;:&quot;red-link-title&quot;,&quot;params&quot;:[&quot;Quần tinh mở&quot;]}}\">quần tinh mở</a> trong <a rel=\"mw:WikiLink\" href=\"./Chòm_sao\" title=\"Chòm sao\" id=\"mwA2Q\">chòm sao</a> <a rel=\"mw:WikiLink\" href=\"./Kim_Ngưu_(chòm_sao)\" title=\"Kim Ngưu (chòm sao)\" id=\"mwA2U\">Kim Ngưu</a>. Những ngôi sao này có chung chuyển động trong không gian.<sup about=\"#mwt321\" class=\"mw-ref reference\" id=\"cite_ref-89\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-89&quot;}}\"><a href=\"./Sao#cite_note-89\" id=\"mwA2Y\"><span class=\"mw-reflink-text\" id=\"mwA2c\"><span class=\"cite-bracket\" id=\"mwA2g\">[</span>88<span class=\"cite-bracket\" id=\"mwA2k\">]</span></span></a></sup> <i id=\"mwA2o\"> Ảnh của <a rel=\"mw:WikiLink\" href=\"./NASA\" title=\"NASA\" id=\"mwA2s\">NASA</a></i>.","text":"Tua Rua, một quần tinh mở trong chòm sao Kim Ngưu. Những ngôi sao này có chung chuyển động trong không gian.[88]  Ảnh của NASA."},"showInGallery":true,"srcset":[{"src":"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4e/Pleiades_large.jpg/500px-Pleiades_large.jpg?utm_source=vi.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","scale":"1x"},{"src":"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4e/Pleiades_large.jpg/1280px-Pleiades_large.jpg?utm_source=vi.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","scale":"2x"}]},{"title":"Tập_tin:Suaur.jpg","leadImage":false,"section_id":19,"type":"image","caption":{"html":"Bề mặt từ trường của sao <a rel=\"mw:WikiLink\" href=\"./SU_Aurigae\" title=\"SU Aurigae\" id=\"mwA4k\">SU<span typeof=\"mw:Entity\" id=\"mwA4o\">&nbsp;</span>Aur</a> (một sao trẻ loại <a rel=\"mw:WikiLink\" href=\"./Sao_T_Tauri\" title=\"Sao T Tauri\" id=\"mwA4s\">sao T Tauri</a>), tạo dựng lại nhờ <a rel=\"mw:WikiLink\" href=\"./Kĩ_thuật_tạo_ảnh_Zeeman-Doppler?action=edit&amp;redlink=1\" title=\"Kĩ thuật tạo ảnh Zeeman-Doppler\" class=\"new\" typeof=\"mw:LocalizedAttrs\" id=\"mwA4w\" data-mw-i18n=\"{&quot;title&quot;:{&quot;lang&quot;:&quot;x-page&quot;,&quot;key&quot;:&quot;red-link-title&quot;,&quot;params&quot;:[&quot;Kĩ thuật tạo ảnh Zeeman-Doppler&quot;]}}\">kĩ thuật tạo ảnh Zeeman-Doppler</a>.","text":"Bề mặt từ trường của sao SU Aur (một sao trẻ loại sao T Tauri), tạo dựng lại nhờ kĩ thuật tạo ảnh Zeeman-Doppler."},"showInGallery":true,"srcset":[{"src":"//thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Suaur.jpg/500px-Suaur.jpg?utm_source=vi.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","scale":"1x"}]},{"title":"Tập_tin:Ngc1999.jpg","leadImage":false,"section_id":20,"type":"image","caption":{"html":"<a rel=\"mw:WikiLink\" href=\"./Tinh_vân_phản_xạ\" title=\"Tinh vân phản xạ\" id=\"mwA6E\">Tinh vân phản xạ</a> <a rel=\"mw:WikiLink\" href=\"./NGC_1999?action=edit&amp;redlink=1\" title=\"NGC 1999\" class=\"new\" typeof=\"mw:LocalizedAttrs\" id=\"mwA6I\" data-mw-i18n=\"{&quot;title&quot;:{&quot;lang&quot;:&quot;x-page&quot;,&quot;key&quot;:&quot;red-link-title&quot;,&quot;params&quot;:[&quot;NGC 1999&quot;]}}\">NGC 1999</a> được chiếu sáng bởi sao V380 Orionis (ở tâm), một sao biến quang với khối lượng khoảng 3,5 lần khối lượng Mặt Trời. Phần màu đen trên hình là một lỗ trống khổng lồ trong không gian chứ không phải là một <a rel=\"mw:WikiLink\" href=\"./Tinh_vân_tối\" title=\"Tinh vân tối\" id=\"mwA6M\">tinh vân tối</a> như đã từng nghĩ trước đây. <i id=\"mwA6Q\">Ảnh của NASA</i>","text":"Tinh vân phản xạ NGC 1999 được chiếu sáng bởi sao V380 Orionis (ở tâm), một sao biến quang với khối lượng khoảng 3,5 lần khối lượng Mặt Trời. Phần màu đen trên hình là một lỗ trống khổng lồ trong không gian chứ không phải là một tinh vân tối như đã từng nghĩ trước đây. Ảnh của NASA"},"showInGallery":true,"srcset":[{"src":"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Ngc1999.jpg/500px-Ngc1999.jpg?utm_source=vi.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","scale":"1x"},{"src":"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Ngc1999.jpg/1280px-Ngc1999.jpg?utm_source=vi.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","scale":"2x"}]},{"title":"Tập_tin:Achernar.jpg","leadImage":false,"section_id":21,"type":"image","caption":{"html":"Hình dạng bầu dục của sao Achernar (α Eridani) do sự tự quay quá nhanh của nó.","text":"Hình dạng bầu dục của sao Achernar (α Eridani) do sự tự quay quá nhanh của nó."