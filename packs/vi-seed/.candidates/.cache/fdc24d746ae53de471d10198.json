{"continue":{"iistart":"2008-01-21T21:18:32Z","continue":"||"},"query":{"normalized":[{"from":"File:Flower_poster_2.jpg","to":"File:Flower poster 2.jpg"}],"pages":{"3427848":{"pageid":3427848,"ns":6,"title":"File:Flower poster 2.jpg","imagerepository":"local","imageinfo":[{"url":"https://upload.wikimedia.org/wikipedia/commons/a/a5/Flower_poster_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Flower_poster_2.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=3427848","extmetadata":{"DateTime":{"value":"2008-01-21 23:20:58","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Flower poster 2","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"GFDL|License migration redundant|Self-published work|Photographs by Alvesgaspar|Files with derivative versions|Mixed flowers|Montages (4x3)","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<p>A poster with twelve flowers of different families: <br>\n</p>\n<ul><li><b>St Bernards Lilly</b> (<i><a href=\"//commons.wikimedia.org/wiki/Anthericum_liliago\" title=\"Anthericum liliago\">Anthericum liliago</a></i>): Liliaceae <br></li>\n<li><b>Bermuda Buttercup</b> (<i><a href=\"//commons.wikimedia.org/wiki/Oxalis_pes-caprae\" title=\"Oxalis pes-caprae\">Oxalis pes-caprae</a></i>): Oxalidaceae <br></li>\n<li><b>Oleander</b> (<i><a href=\"//commons.wikimedia.org/wiki/Nerium_oleander\" title=\"Nerium oleander\">Nerium oleander</a></i>): Apocynaceae <br></li>\n<li><b>Lantana</b> (<i><a href=\"//commons.wikimedia.org/wiki/Lantana_camara\" title=\"Lantana camara\">Lantana camara</a></i>): Verbenaceae <br></li>\n<li><b>Scarlet Pimpernel</b> (<i><a href=\"//commons.wikimedia.org/wiki/Anagallis_arvensis\" class=\"mw-redirect\" title=\"Anagallis arvensis\">Anagallis arvensis</a></i>): Primulaceae <br></li>\n<li><b>Verbascum</b> (<i><a href=\"//commons.wikimedia.org/wiki/Verbascum_sinuatum\" title=\"Verbascum sinuatum\">Verbascum sinuatum</a></i>): Scrophulariaceae <br></li>\n<li><b>Common Mallow</b> (<i><a href=\"//commons.wikimedia.org/wiki/Malva_sylvestris\" title=\"Malva sylvestris\">Malva sylvestris</a></i>): Malvaceae <br></li>\n<li><b>Spanish Oyster</b> (<i><a href=\"//commons.wikimedia.org/wiki/Scolymus_hispanicus\" title=\"Scolymus hispanicus\">Scolymus hispanicus</a></i>): Asteraceae <br></li>\n<li><b>Stork's Bill</b> (<i><a href=\"//commons.wikimedia.org/wiki/Erodium_malacoides\" title=\"Erodium malacoides\">Erodium malacoides</a></i>): Geraniaceae <br></li>\n<li><b>Bindweed</b> (<i><a href=\"//commons.wikimedia.org/wiki/Convolvulus_arvensis\" title=\"Convolvulus arvensis\">Convolvulus arvensis</a></i>): Convolvulaceae <br></li>\n<li><b>Blue Gem</b> (<i><a href=\"//commons.wikimedia.org/wiki/Hebe\" class=\"mw-redirect\" title=\"Hebe\">Hebe</a> x franciscana</i>): Plantaginaceae <br></li>\n<li><b>Calla Lily</b> (<i><a href=\"//commons.wikimedia.org/wiki/Zantedeschia_aethiopica\" title=\"Zantedeschia aethiopica\">Zantedeschia aethiopica</a></i>): Araceae</li></ul>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2008-01","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Alvesgaspar\" title=\"User:Alvesgaspar\">Alvesgaspar</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 3.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 3.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/3.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","s