{
  "expo": {
    "name": "Ghép Chữ",
    "slug": "word-blocks",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E9FBF2",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Để chọn ảnh minh hoạ cho mỗi từ trong bộ từ vựng.",
        "NSCameraUsageDescription": "Để chụp ảnh minh hoạ cho một từ.",
        "NSMicrophoneUsageDescription": "Để thu âm giọng đọc cho mỗi từ.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.sleepyshark.ghepchu",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.sleepyshark.ghepchu",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E9FBF2"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E9FBF2",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Để chọn ảnh minh hoạ cho mỗi từ trong bộ từ vựng.",
          "cameraPermission": "Để chụp ảnh minh hoạ cho một từ."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "120f3777-5e00-44e1-a359-f76ab51fbced"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E9FBF2"
    }
  }
}
